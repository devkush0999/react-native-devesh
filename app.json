{
  "expo": {
    "name": "Saathi",
    "slug": "saathi-private-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "saathi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deveshrn.saathi",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": true
      }
    },
    "android": {
      "package": "com.saathi.privateai",
      "allowBackup": false
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Saathi uses your microphone when you start a voice note or voice assistant. Audio is processed on your device.",
          "iosBackgroundMode": false,
          "androidPermissions": ["android.permission.RECORD_AUDIO", "android.permission.MODIFY_AUDIO_SETTINGS"],
          "androidForegroundService": false,
          "disableFFmpeg": true,
          "disableStaticExternalLibs": true
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 33
          }
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],
    "web": {
      "name": "Saathi — a little less on your mind",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "58a4cff4-25ba-4ccc-b712-15917b96daee"
      }
    },
    "owner": "devesh-rn"
  }
}
